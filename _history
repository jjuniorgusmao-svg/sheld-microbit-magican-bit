     pins.digitalWritePin(DigitalPin.P13, 0)\n                pins.analogWritePin(AnalogPin.P14, velCalculada)\n            }\n        }\n    }\n\n    /**\n     * Desliga as saídas de um motor específico\n     * @param p motor a ser desligado (ML ou MR)\n     */\n    //% block=\"parar motor %p\"\n    //% p.fieldEditor=\"gridpicker\"\n    export function parar(p: MLouMR): void {\n        if (p == MLouMR.ML) {\n            pins.digitalWritePin(DigitalPin.P15, 0)\n            pins.digitalWritePin(DigitalPin.P16, 0)\n        } else {\n            pins.digitalWritePin(DigitalPin.P13, 0)\n            pins.digitalWritePin(DigitalPin.P14, 0)\n        }\n    }\n}","pxt.json":"{\n    \"name\": \"shield\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"SHIELD.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1787005215021,"editorVersion":"9.0.8","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"device_pause\" disabled-reasons=\"pxt_automatic_disabled\" x=\"205\" y=\"-149\"><value name=\"pause\"><shadow type=\"timePicker\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"ms\">100</field></shadow></value></block><block type=\"math_map\" disabled-reasons=\"pxt_automatic_disabled\" x=\"430\" y=\"-149\"><value name=\"value\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"NUM\">1</field></shadow></value><value name=\"fromLow\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"NUM\">0</field></shadow></value><value name=\"fromHigh\"><shadow type=\"math_number\" disabled-reasons=\"pxt_automatic_disabled\"><field name=\"NUM\">100</field></shadow></value><value name=\"toLow\"><shadow type=\"math_number\" disabled-reasons=